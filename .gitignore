# Dependencies
node_modules/

# Next.js
.next/

# Next.js build output (sometimes used)
out/

# TypeScript/ESLint cache
.next/cache/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files (keep secrets out of git)
.env
.env.*
!.env.example
!.env.local.example

# Local env overrides
.env*.local

# Secrets / credentials
*.pem
*.p12
*.key
*.crt
*.cer
*.jks

# Common secret filenames
secret*
*secret*
credentials*
*.secret
private*
*.private

# Misc
.DS_Store

# Optional: macOS hidden files
._*

# Safety: ignore editor/project files that may contain paths/secrets
.vscode/
.idea/
*.iml

